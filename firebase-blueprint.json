{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with display name and pairing reference",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 128 },
        "avatarId": { "type": "string", "maxLength": 64 },
        "inviteCode": { "type": "string", "maxLength": 16 },
        "pairedFriendUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "displayName", "inviteCode", "createdAt"]
    },
    "DailyCount": {
      "title": "DailyCount",
      "description": "Daily aggregate poop count for a specific date without individual event timestamps",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "dateKey": { "type": "string", "maxLength": 16 },
        "count": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "dateKey", "count", "updatedAt"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Friendship link between two users",
      "type": "object",
      "properties": {
        "friendshipId": { "type": "string", "maxLength": 256 },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "number" }
      },
      "required": ["friendshipId", "memberUids", "createdAt"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Pending invite request between two users",
      "type": "object",
      "properties": {
        "requestId": { "type": "string", "maxLength": 128 },
        "senderUid": { "type": "string", "maxLength": 128 },
        "recipientCode": { "type": "string", "maxLength": 16 },
        "senderName": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "maxLength": 16 },
        "createdAt": { "type": "number" }
      },
      "required": ["requestId", "senderUid", "recipientCode", "senderName", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "entities/User" },
      "description": "User profiles indexed by UID"
    },
    "/dailyCounts/{countId}": {
      "schema": { "$ref": "entities/DailyCount" },
      "description": "Aggregate daily counts for each user and date"
    },
    "/friendships/{friendshipId}": {
      "schema": { "$ref": "entities/Friendship" },
      "description": "Friendship pairings"
    },
    "/friendRequests/{requestId}": {
      "schema": { "$ref": "entities/FriendRequest" },
      "description": "Incoming and outgoing friend requests"
    }
  }
}
